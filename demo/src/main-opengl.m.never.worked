#import <MulleUICore/MulleUICore.h>


@interface TestOpenGLLayer : CALayer
@end



@implementation TestOpenGLLayer

- (instancetype) initWithFrame:(CGRect) frame
{
   [super initWithFrame:frame];

   _canvas = CGRectMake( -1.0, -1.0, 2.0, 2.0);
   _bounds = CGRectMake( -1.0, -1.0, 2.0, 2.0);

   return( self);
}


static void   transformOpenGL( CGAffineTransform *t)
{
   GLfloat   matrix[ 4][ 4];


   // https://stackoverflow.com/questions/31721306/how-do-i-convert-a-2d-transformation-matrix-for-homogeneous-coordinates-into-3#31721700

   //   [sx kx tx]  or  [a c e]
   //   [ky sy ty]  or  [b d f]
   //   [ 0  0  1]  or  [0 0 1]

   // a b 0 c
   // d e 0 f
   // 0 0 1 0
   // g h 0 i

   memset( matrix, 0, sizeof( matrix));

   matrix[ 0][ 0] = t->a;
   matrix[ 0][ 1] = t->c;
//   matrix[ 0][ 2] =
   matrix[ 0][ 3] = t->tx; // .e

   matrix[ 1][ 0] = t->b;
   matrix[ 1][ 1] = t->d;
//   matrix[ 1][ 2] =
   matrix[ 1][ 3] = t->ty;  // .f

//   matrix[ 2][ 0] =
//   matrix[ 2][ 1] =
   matrix[ 2][ 2] = 1.0;
//   matrix[ 2][ 3] =

//   matrix[ 3][ 0] =
//   matrix[ 3][ 1] =
//   matrix[ 3][ 2] =
   matrix[ 3][ 3] = 1.0f;

   glMultMatrixf( (GLfloat *) matrix);
}


// trying hard to live without glu calls, why ?
// https://www.songho.ca/opengl/gl_transform.html
static void   makeFrustum( double fovY, double aspectRatio, double front, double back)
{
    double tangent;
    double height;
    double width;

#define DEG2RAD   (3.14159265 / 180)

    tangent = tan(fovY/2 * DEG2RAD);   // tangent of half fovY
    height  = front * tangent;          // half height of near plane
    width   = height * aspectRatio;      // half width of near plane

    // params: left, right, bottom, top, near, far
    glFrustum(-width, width, -height, height, front, back);
}


- (void) setupOpenGLProjection:(CGFloat) fov
{
   CGRect   canvas;

   canvas = [self canvas];

   glMatrixMode( GL_PROJECTION); // Select The Projection Matrix
   glLoadIdentity();
   makeFrustum( fov, canvas.size.width / canvas.size.height, 0, 1.0);
}


- (void) setupOpenGLModelView
{
   CGAffineTransform   localTransform;
   CGAffineTransform   xform;
   CGAffineTransform   scaler;
   CGAffineTransform   mover;
   CGRect              bounds;
   CGRect              canvas;

   bounds = [self bounds];

   glMatrixMode(GL_MODELVIEW);  // guess
   glLoadIdentity();

   localTransform = CGAffineTransformMakeProjection( _frame, bounds);
   xform          = CGAffineTransformConcat( _transform, localTransform);

   canvas  = [self canvas];
   // scale down so that we end up at 0.0, 2.0
   mover   = CGAffineTransformMakeTranslation( canvas.size.width / 2.0f, canvas.size.height / 2.0f);
//   scaler  = CGAffineTransformMakeScale( canvas.size.width / 32.0, canvas.size.height/ 32.0);

   xform   = CGAffineTransformConcat( xform, mover);
//   xform   = CGAffineTransformConcat( xform, scaler);

   // so move it so 0.0 is at centerPoint

   transformOpenGL( &xform);
}


/*
 * The bounds pick out a portion of the canvas and project it into the frame.
 * Lets assume for simplicity that the layer frame and the UIView frame cover
 * the same window space.
 *
 * https://learnopengl.com/Getting-started/Coordinate-Systems
 * OpenGL sees the UIWindow not as 0,0 640,400 but as -1,-1 1,1 usually.
 *
 *       0
 *     0 .------------------------------.
 *       | UIWindow                     |
 *       |                              |
 *       |         .---------------.    |
 *       |         | UIView        |    |
 *       |         |               |    |
 *       |         | frame         |    |
 *       |         |               |    |
 *       |         '---------------'    |
 *       |                 ^            |
 *       |                 |            |
 *       '-----------------|------------' 400
 *                         |           640
 *                    .--------.
 *        .-----------|        |
 *        | CALayer   | bounds |
 *        |           |        |
 *        | canvas    '--------'
 *        |                  |
 *        '------------------'
 *
 * So what we draw in the

 *
 */
- (void) renderInContext:(CGContext *) context
{
   CGFloat   alpha;
   CGRect    bounds;
   CGRect    localClipRect;

   assert( context);

   bounds = [self bounds];
#ifdef RENDER_DEBUG
   fprintf( stderr, "%s %s (f:%s b:%s)\n",
                        __PRETTY_FUNCTION__,
                        [self UTF8String],
                        CGRectUTF8String( _frame),
                        CGRectUTF8String( bounds));
#endif


   if( _hidden == YES)
      return;
   if( _frame.size.width == 0.0 || _frame.size.height == 0.0)
      return;
   if( bounds.size.width == 0.0 || bounds.size.height == 0.0)
      return;

   alpha = _opacity * _alpha;
   if( CGAlphaIsTransparent( alpha))
      return;

   [context suspendRender];

   glMatrixMode( GL_PROJECTION); // Select The Projection Matrix
   glPushMatrix();
   //
   // if any dimension is zero size, nothing gets painted anyway...
   //


   // this is the "inherited" alpha from UIVIew
   // cull layers which are invisible


   // these are the bounds in global screen space
   if( _clipRect.size.width != INFINITY)  // transform set by UIView during layout
   {
      glEnable( GL_SCISSOR_TEST);
      // scissor is window space, so this looks OK
      glScissor( _clipRect.origin.x,
                 _clipRect.origin.y,
                 _clipRect.size.width,
                 _clipRect.size.height);
   }


   // we are still in frame space, here so calculate the bounds scissor
   // somewhat inconveniently
   if( _masksToBounds)
   {
      localClipRect = CGRectApplyAffineTransform( bounds, _transform);

      if( _clipRect.size.width != INFINITY)
         localClipRect = CGRectIntersection( localClipRect, _clipRect);
      else
         glEnable( GL_SCISSOR_TEST);

      glScissor( localClipRect.origin.x,
                 localClipRect.origin.y,
                 localClipRect.size.width,
                 localClipRect.size.height);
   }

   //
   // this is the "inherited" transform from UIVIew
   // we just keep the viewport as is I guess, why bother ?
   //

   // our local transforms are in NVG space, we should convert this to the
   // -1.0 1.0 of OpenGL though

   [self setupOpenGLProjection:120.0];
   [self setupOpenGLModelView];

   [self drawInContext:context];

   glFlush();

   glMatrixMode( GL_PROJECTION); // Select The Projection Matrix
   glPopMatrix();

   [context resumeRender];
}


@end


static void   drawOpenGLStuff( CALayer *layer, CGContext *context)
{
   glColor3f( 0.0f, 0.0f, 1.0f ); // blue color
   glLineWidth( 4.0f);
 //  glScalef( 0.2, 0.2, 1.0);
   glBegin( GL_LINE_LOOP);
      glVertex3f( -0.5f, 0.0f, 0.0f );
      glVertex3f( 0.0f, -0.5f, 0.0f );
      glVertex3f( 0.5f, 0.0f,  0.0f );
      glVertex3f( 0.0f, 0.5f,  0.0f );
   glEnd();
}


static void   setupSceneInView( UIView *contentPlane)
{
   UIView          *view;
   CGRect          frame;
   CAOpenGLLayer   *layer;

   frame = [contentPlane contentRect];
   frame = UIEdgeInsetsInsetRect( frame, UIEdgeInsetsMake( 10, 10, 10, 10));

   view  = [UIView viewWithFrame:frame];
   [view setBackgroundColor:CGColorMakeRGBA( 0.5, 0.5, 0.5, 0.5)];

   // for "fun" add the OpenGL layer on top of our regular CALayer
   layer = [TestOpenGLLayer layerWithFrame:[view contentRect]];
   [view addLayer:layer];
   [layer setDrawCallback:drawOpenGLStuff];

   [contentPlane addSubview:view];
}



int   main( int argc, char *argv[])
{
   UIWindow        *window;
   UIApplication   *app;

   app = [UIApplication sharedInstance];
   {
      window = [UIWindow windowWithFrame:CGRectMake( 0.0, 0.0, 800.0, 600.0)];
      assert( window);

      [window setBackgroundColor:CGColorMakeRGBA( 1.0, 1.0, 1.0, 1.0)];

      setupSceneInView( [window contentPlane]);

      [app addWindow:window];
      [window frameLoop];
   }
   return( [app terminate]);
}



